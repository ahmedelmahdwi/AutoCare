<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تسجيل فاتورة شراء وتوريد مخزون جديدة" Width="840" Height="660"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI, Tahoma, Arial"
        Background="{DynamicResource BackgroundBrush}">

    <Window.Resources>
        <Style x:Key="DlgInputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="0,4,0,10"/>
        </Style>

        <Style x:Key="DlgComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="0,4,0,10"/>
        </Style>

        <!-- Save Green Button -->
        <Style x:Key="BtnDialogSave" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinWidth" Value="160"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#34D399"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="#059669"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Blue Button -->
        <Style x:Key="BtnDialogPrimary" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#0284C7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#38BDF8"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="#0369A1"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cancel Slate Button -->
        <Style x:Key="BtnDialogCancel" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#E2E8F0"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="#CBD5E1"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Header Title -->
        <TextBlock Grid.Row="0" Text="📦 تسجيل فاتورة شراء وتوريد قطع غيار للمخزن" FontSize="19" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,14"/>

        <!-- 2. Invoice General Info Card -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="المورد / الشركة الموردة:" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155"/>
                    <ComboBox ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}"
                              DisplayMemberPath="SupplierName" Style="{StaticResource DlgComboStyle}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="رقم الفاتورة:" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155"/>
                    <TextBox Text="{Binding InvoiceNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DlgInputStyle}"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="ملاحظات وبيان التوريد:" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155"/>
                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DlgInputStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. Add Spare Part Entry Box -->
        <Border Grid.Row="2" Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="اختيار قطعة الغيار من المخزن:" FontSize="12.5" FontWeight="SemiBold" Foreground="#0369A1"/>
                    <ComboBox ItemsSource="{Binding AvailableParts}" SelectedItem="{Binding SelectedPart}"
                              DisplayMemberPath="PartName" Style="{StaticResource DlgComboStyle}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="الكمية الموردة:" FontSize="12.5" FontWeight="SemiBold" Foreground="#0369A1"/>
                    <TextBox Text="{Binding InputQuantity, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DlgInputStyle}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                    <TextBlock Text="سعر الشراء (د.ل):" FontSize="12.5" FontWeight="SemiBold" Foreground="#0369A1"/>
                    <TextBox Text="{Binding InputUnitCost, UpdateSourceTrigger=PropertyChanged, StringFormat='N2'}" Style="{StaticResource DlgInputStyle}"/>
                </StackPanel>

                <Button Grid.Column="3" Content="➕ إضافة للبند" Command="{Binding AddItemCommand}"
                        Style="{StaticResource BtnDialogPrimary}" VerticalAlignment="Bottom" Margin="0,0,0,10" Height="38"/>
            </Grid>
        </Border>

        <!-- 4. Purchased Items DataGrid -->
        <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="1" Margin="0,0,0,12">
            <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                      AutoGenerateColumns="False" CanUserAddRows="False"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0"
                      RowHeight="38" FontSize="13" BorderThickness="0" Background="Transparent">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="كود القطعة" Binding="{Binding PartCode}" Width="120" IsReadOnly="True"/>
                    <DataGridTextColumn Header="اسم قطعة الغيار" Binding="{Binding PartName}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity}" Width="90"/>
                    <DataGridTextColumn Header="سعر الشراء للوحدة" Binding="{Binding UnitCostDisplay}" Width="140" IsReadOnly="True"/>
                    <DataGridTextColumn Header="الإجمالي" Binding="{Binding TotalCostDisplay}" Width="140" IsReadOnly="True"/>
                    <DataGridTemplateColumn Header="إجراء" Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="✕" ToolTip="حذف البند"
                                        Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        Background="#FEE2E2" Foreground="#EF4444" FontWeight="Bold"
                                        BorderThickness="0" Width="30" Height="26" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 5. Footer Summary & Action Buttons -->
        <Border Grid.Row="4" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="0,12,0,0">
            <DockPanel>
                <!-- Total Amount Badge on Right -->
                <Border DockPanel.Dock="Right" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="16,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="إجمالي الفاتورة: " FontSize="14" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding TotalAmountDisplay}" FontSize="16" FontWeight="ExtraBold" Foreground="#0284C7" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Actions on Left -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Content="💾 حفظ واعتماد الفاتورة وتوريد المخزن" Command="{Binding SaveCommand}" Style="{StaticResource BtnDialogSave}"/>
                    <Button Content="✕ إلغاء" Command="{Binding CancelCommand}" IsCancel="True" Style="{StaticResource BtnDialogCancel}" Margin="12,0,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
