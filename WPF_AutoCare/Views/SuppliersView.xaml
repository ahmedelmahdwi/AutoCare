<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             FontFamily="Segoe UI, Tahoma, Arial"
             Background="{DynamicResource BackgroundBrush}">

    <UserControl.Resources>
        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#0284C7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#38BDF8"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="#0369A1"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnSuccess" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#34D399"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="#059669"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
            <Setter Property="Background" Value="#EF4444"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#F87171"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="#DC2626"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnSecondary" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#E2E8F0"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="#CBD5E1"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Clean TabItem Style -->
        <Style x:Key="ModernTabItem" TargetType="TabItem">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="bd" Background="Transparent" BorderThickness="0,0,0,3" BorderBrush="Transparent" Margin="0,0,16,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="headerPresenter" ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.FontWeight="Bold"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#BAE6FD"/>
                                <Setter TargetName="headerPresenter" Property="TextElement.Foreground" Value="#0284C7"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#0284C7"/>
                                <Setter TargetName="headerPresenter" Property="TextElement.Foreground" Value="#0284C7"/>
                                <Setter TargetName="headerPresenter" Property="TextElement.FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title Row -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,0,2,10">
            <TextBlock Text="الموردين وفواتير المشتريات" FontSize="23" FontWeight="Bold" FontFamily="{StaticResource HeaderFontFamily}" Foreground="#0F172A"/>
        </StackPanel>

        <!-- Main Tab Control -->
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}" Background="Transparent" BorderThickness="0">
            
            <!-- ══════════════ TAB 1: سجل الموردين ══════════════ -->
            <TabItem Header="🏢  سجل الموردين" Style="{StaticResource ModernTabItem}">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Suppliers Toolbar -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,4">
                        <!-- Search Box on Right -->
                        <TextBox DockPanel.Dock="Right" Width="280" Height="38" FontSize="13.5" VerticalContentAlignment="Center"
                                 Padding="10,0" Margin="0,0,0,0"
                                 Text="{Binding SupplierSearchText, UpdateSourceTrigger=PropertyChanged}"/>

                        <!-- Action Buttons on Left -->
                        <Button DockPanel.Dock="Left" Content="+ إضافة مورد" Command="{Binding AddSupplierCommand}" Width="140" Style="{StaticResource BtnSuccess}" Visibility="{Binding ManagementVisibility}"/>
                        <Button DockPanel.Dock="Left" Content="تعديل المورد" Command="{Binding EditSupplierCommand}" Width="120" Style="{StaticResource BtnPrimary}" Margin="10,0,0,0" Visibility="{Binding ManagementVisibility}"/>
                        <Button DockPanel.Dock="Left" Content="حذف" Command="{Binding DeleteSupplierCommand}" Width="90" Style="{StaticResource BtnDanger}" Margin="10,0,0,0" Visibility="{Binding ManagementVisibility}"/>
                    </DockPanel>

                    <!-- Suppliers DataGrid -->
                    <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E3EAF1" BorderThickness="1" CornerRadius="12" Margin="0,10,0,0" Padding="1">
                        <DataGrid ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0"
                                  RowHeight="40" FontSize="13" FontWeight="Normal" SelectionMode="Single"
                                  BorderThickness="0" Background="Transparent">
                            <DataGrid.InputBindings>
                                <MouseBinding Gesture="LeftDoubleClick" Command="{Binding EditSupplierCommand}"/>
                            </DataGrid.InputBindings>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="رقم المورد" Binding="{Binding SupplierID}" Width="90"/>
                                <DataGridTextColumn Header="اسم المورد / الشركة" Binding="{Binding SupplierName}" Width="220"/>
                                <DataGridTextColumn Header="مسؤول الاتصال" Binding="{Binding ContactPerson}" Width="160"/>
                                <DataGridTextColumn Header="رقم الهاتف" Binding="{Binding PhoneNumber}" Width="140"/>
                                <DataGridTextColumn Header="العنوان" Binding="{Binding Address}" Width="180"/>
                                <DataGridTextColumn Header="الرصيد المستحق" Binding="{Binding BalanceDisplay}" Width="140"/>
                                <DataGridTextColumn Header="تاريخ التسجيل" Binding="{Binding CreatedAt}" Width="130"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ══════════════ TAB 2: فواتير المشتريات والتوريد ══════════════ -->
            <TabItem Header="🧾  فواتير المشتريات والتوريد" Style="{StaticResource ModernTabItem}">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Purchases Toolbar -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,4">
                        <!-- Search Box on Right -->
                        <TextBox DockPanel.Dock="Right" Width="280" Height="38" FontSize="13.5" VerticalContentAlignment="Center"
                                 Padding="10,0" Margin="0,0,0,0"
                                 Text="{Binding InvoiceSearchText, UpdateSourceTrigger=PropertyChanged}"/>

                        <!-- Action Buttons on Left -->
                        <Button DockPanel.Dock="Left" Content="+ فاتورة شراء جديدة" Command="{Binding NewPurchaseInvoiceCommand}" Width="190" Style="{StaticResource BtnSuccess}" Visibility="{Binding ManagementVisibility}"/>
                        <Button DockPanel.Dock="Left" Content="تفاصيل الفاتورة" Command="{Binding ViewInvoiceDetailsCommand}" Width="140" Style="{StaticResource BtnPrimary}" Margin="10,0,0,0"/>
                        <Button DockPanel.Dock="Left" Content="🔄 تحديث" Command="{Binding RefreshInvoicesCommand}" Width="90" Style="{StaticResource BtnSecondary}" Margin="10,0,0,0"/>
                    </DockPanel>

                    <!-- Invoices DataGrid -->
                    <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E3EAF1" BorderThickness="1" CornerRadius="12" Margin="0,10,0,0" Padding="1">
                        <DataGrid ItemsSource="{Binding Invoices}" SelectedItem="{Binding SelectedInvoice}"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0"
                                  RowHeight="40" FontSize="13" FontWeight="Normal" SelectionMode="Single"
                                  BorderThickness="0" Background="Transparent">
                            <DataGrid.InputBindings>
                                <MouseBinding Gesture="LeftDoubleClick" Command="{Binding ViewInvoiceDetailsCommand}"/>
                            </DataGrid.InputBindings>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="رقم الفاتورة" Binding="{Binding PurchaseInvoiceNumber}" Width="130"/>
                                <DataGridTextColumn Header="اسم المورد" Binding="{Binding SupplierName}" Width="220"/>
                                <DataGridTextColumn Header="تاريخ الفاتورة" Binding="{Binding InvoiceDate}" Width="150"/>
                                <DataGridTextColumn Header="إجمالي الفاتورة" Binding="{Binding TotalAmount}" Width="140"/>
                                <DataGridTextColumn Header="ملاحظات" Binding="{Binding Notes}" Width="*"/>
                                <DataGridTextColumn Header="أنشئت بواسطة" Binding="{Binding CreatedBy}" Width="130"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
