<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="حجز موعد صيانة جديد" Width="580" Height="680"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI, Tahoma, Arial"
        Background="{DynamicResource BackgroundBrush}">

    <Window.Resources>
        <Style x:Key="DlgInputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="0,4,0,12"/>
        </Style>

        <Style x:Key="DlgComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="0,4,0,12"/>
        </Style>

        <Style x:Key="BtnDialogSave" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Width" Value="160"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#34D399"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#059669"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnDialogCancel" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Width" Value="120"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,16" Padding="0,0,0,12" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Border Width="44" Height="44" CornerRadius="10" Background="#EFF6FF" Margin="0,0,14,0">
                    <TextBlock Text="📅" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="حجز موعد صيانة جديد" FontSize="20" FontWeight="Bold" FontFamily="{StaticResource HeaderFontFamily}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="تسجيل بيانات العميل، المركبة وتخصيص الفني بدون تعارض" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Form Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,0">

                <!-- Customer Section -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="رقم هاتف العميل *" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBox Style="{StaticResource DlgInputStyle}" Text="{Binding CustomerPhone, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="اسم العميل *" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBox Style="{StaticResource DlgInputStyle}" Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <!-- Vehicle Section -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="رقم اللوحة *" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBox Style="{StaticResource DlgInputStyle}" Text="{Binding PlateNumber, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="نوع وموديل المركبة" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBox Style="{StaticResource DlgInputStyle}" Text="{Binding CarModel, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <!-- Appointment Date & Times -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.4*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="تاريخ الحجز *" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <DatePicker Height="40" Margin="0,4,0,12" SelectedDate="{Binding AppointmentDate, Mode=TwoWay}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="من (البداية)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <ComboBox Style="{StaticResource DlgComboStyle}"
                                  ItemsSource="{Binding AvailableTimeSlots}"
                                  SelectedItem="{Binding SelectedStartTime, Mode=TwoWay}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="إلى (النهاية)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <ComboBox Style="{StaticResource DlgComboStyle}"
                                  ItemsSource="{Binding AvailableTimeSlots}"
                                  SelectedItem="{Binding SelectedEndTime, Mode=TwoWay}"/>
                    </StackPanel>
                </Grid>

                <!-- Technician Assignment -->
                <StackPanel Margin="0,0,0,4">
                    <TextBlock Text="الفني المسؤول (اختياري مع فحص التعارض الذكي)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <ComboBox Style="{StaticResource DlgComboStyle}"
                              ItemsSource="{Binding TechniciansList}"
                              SelectedItem="{Binding SelectedTechnician, Mode=TwoWay}"
                              DisplayMemberPath="Name"/>
                </StackPanel>

                <!-- Conflict Alert Banner -->
                <Border Margin="0,0,0,12" Padding="12,10" CornerRadius="8"
                        Background="#FEF2F2" BorderBrush="#F87171" BorderThickness="1"
                        Visibility="{Binding HasConflict, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding ConflictMessage}" FontSize="12.5" FontWeight="SemiBold" Foreground="#DC2626"/>
                </Border>

                <!-- Notes / Issue Description -->
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="ملاحظات الحجز / سبب الزيارة" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                             Height="80" TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" FontSize="13.5"
                             Padding="10" Margin="0,4,0,0"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer Actions -->
        <Border Grid.Row="2" Margin="0,12,0,0" Padding="0,12,0,0" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Style="{StaticResource BtnDialogSave}" Content="✓ تأكيد وحفظ الموعد" Command="{Binding SaveCommand}" Margin="0,0,12,0"/>
                <Button Style="{StaticResource BtnDialogCancel}" Content="إلغاء" Command="{Binding CancelCommand}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
