<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تسجيل الدخول - WPF Auto Care"
        Width="480" Height="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Acrylic Glass Button Template -->
        <ControlTemplate x:Key="LoginBtnTemplate" TargetType="Button">
            <Border x:Name="bd" CornerRadius="12" SnapsToDevicePixels="True" BorderThickness="1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#0EA5E9" Offset="0.0"/>
                        <GradientStop Color="#0284C7" Offset="0.55"/>
                        <GradientStop Color="#0369A1" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#B0FFFFFF" Offset="0.0"/>
                        <GradientStop Color="#40FFFFFF" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,2,10,2"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="bd" Property="Background">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#38BDF8" Offset="0.0"/>
                                <GradientStop Color="#0EA5E9" Offset="0.55"/>
                                <GradientStop Color="#0284C7" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                    <Setter TargetName="bd" Property="BorderBrush" Value="#E0FFFFFF"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Chrome Button Templates -->
        <ControlTemplate x:Key="ChromeCloseBtnTemplate" TargetType="Button">
            <Border x:Name="bd" CornerRadius="14" Background="#28FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="bd" Property="Background" Value="#DC2626"/>
                    <Setter TargetName="bd" Property="BorderBrush" Value="#80FFFFFF"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate x:Key="ChromeMinBtnTemplate" TargetType="Button">
            <Border x:Name="bd" CornerRadius="14" Background="#28FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="bd" Property="Background" Value="#2563EB"/>
                    <Setter TargetName="bd" Property="BorderBrush" Value="#80FFFFFF"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Server Settings Pill Button Template -->
        <ControlTemplate x:Key="PillBtnTemplate" TargetType="Button">
            <Border x:Name="bd" CornerRadius="14" Background="#1AFFFFFF" BorderBrush="#3DFFFFFF" BorderThickness="1" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="bd" Property="Background" Value="#30FFFFFF"/>
                    <Setter TargetName="bd" Property="BorderBrush" Value="#8038BDF8"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Glass Input Style -->
        <Style x:Key="GlassInputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="#38BDF8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="IBeam"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" CornerRadius="12" Background="#26FFFFFF" BorderBrush="#4DFFFFFF" BorderThickness="1.5">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="12,8,12,8" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#9038BDF8"/>
                                <Setter TargetName="bd" Property="Background" Value="#38FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#38BDF8"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="bd" Property="Background" Value="#45FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer Acrylic Glass Container -->
    <Border x:Name="outerBorder" CornerRadius="24" BorderThickness="1.5" SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect Color="#020810" Direction="270" ShadowDepth="14" BlurRadius="40" Opacity="0.75"/>
        </Border.Effect>
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#4538BDF8" Offset="0.0"/>
                <GradientStop Color="#201E3A5F" Offset="0.5"/>
                <GradientStop Color="#3538BDF8" Offset="1.0"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#071322" Offset="0.0"/>
                <GradientStop Color="#0B1D33" Offset="0.42"/>
                <GradientStop Color="#0F2847" Offset="0.78"/>
                <GradientStop Color="#06101D" Offset="1.0"/>
            </LinearGradientBrush>
        </Border.Background>

        <Grid ClipToBounds="True">
            <!-- Radiant Glowing Atmospheric Accents (Harmonious Oceanic/Navy Palette) -->
            <!-- Orb 1: Soft Cyan/Blue Ambient Glow Top-Right -->
            <Ellipse Width="300" Height="300" HorizontalAlignment="Right" VerticalAlignment="Top" 
                     Margin="0,-60,-60,0" IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#4038BDF8" Offset="0.0"/>
                        <GradientStop Color="#150284C7" Offset="0.55"/>
                        <GradientStop Color="#000284C7" Offset="1.0"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Effect>
                    <BlurEffect Radius="80"/>
                </Ellipse.Effect>
            </Ellipse>

            <!-- Orb 2: Deep Sapphire Glow Bottom-Left -->
            <Ellipse Width="320" Height="320" HorizontalAlignment="Left" VerticalAlignment="Bottom" 
                     Margin="-70,0,0,-70" IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#300284C7" Offset="0.0"/>
                        <GradientStop Color="#100369A1" Offset="0.6"/>
                        <GradientStop Color="#000369A1" Offset="1.0"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Effect>
                    <BlurEffect Radius="85"/>
                </Ellipse.Effect>
            </Ellipse>

            <!-- Orb 3: Subtle Center Atmospheric Depth -->
            <Ellipse Width="220" Height="220" HorizontalAlignment="Center" VerticalAlignment="Center" 
                     Margin="30,40,0,0" IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#1C0EA5E9" Offset="0.0"/>
                        <GradientStop Color="#000EA5E9" Offset="1.0"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Effect>
                    <BlurEffect Radius="70"/>
                </Ellipse.Effect>
            </Ellipse>

            <!-- Minimalist Title Bar -->
            <Grid Height="44" VerticalAlignment="Top" Background="Transparent">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,16,0">
                    <TextBlock Text="WPF Auto Care" FontSize="12.5" FontWeight="SemiBold" Foreground="#C8E2E8F0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="14,0,0,0">
                    <Button Content="—" Width="28" Height="28" FontSize="11" Foreground="White" Cursor="Hand"
                            Template="{StaticResource ChromeMinBtnTemplate}" Command="{Binding MinimizeCommand}"/>
                    <Button Content="✕" Width="28" Height="28" FontSize="11" Foreground="White" Cursor="Hand" Margin="8,0,0,0"
                            Template="{StaticResource ChromeCloseBtnTemplate}" Command="{Binding CloseCommand}"/>
                </StackPanel>
            </Grid>

            <!-- Centered Authentic Frosted Glass Card -->
            <Border Width="406" CornerRadius="22" BorderThickness="1.2" Padding="32,24,32,22" 
                    HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,28,0,14" SnapsToDevicePixels="True">
                <Border.Effect>
                    <DropShadowEffect Color="#020810" Direction="270" ShadowDepth="12" BlurRadius="36" Opacity="0.65"/>
                </Border.Effect>
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#60FFFFFF" Offset="0.0"/>
                        <GradientStop Color="#3038BDF8" Offset="0.4"/>
                        <GradientStop Color="#15FFFFFF" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#E60A1E30" Offset="0.0"/>
                        <GradientStop Color="#F2071724" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>

                <StackPanel>
                    <!-- Logo Badge -->
                    <Border Width="76" Height="76" CornerRadius="20" BorderThickness="1.4" 
                            HorizontalAlignment="Center" Margin="0,0,0,12" SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect Color="#38BDF8" Direction="270" ShadowDepth="2" BlurRadius="16" Opacity="0.35"/>
                        </Border.Effect>
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#80FFFFFF" Offset="0.0"/>
                                <GradientStop Color="#5038BDF8" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#250284C7" Offset="0.0"/>
                                <GradientStop Color="#15071724" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Image x:Name="logoImg" Source="app_logo.png" Width="56" Height="56" Stretch="Uniform"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>

                    <!-- Title & Subtitle -->
                    <TextBlock Text="WPF Auto Care" FontSize="23" FontWeight="Bold" FontFamily="{StaticResource HeaderFontFamily}" Foreground="White" HorizontalAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="Black" Direction="270" ShadowDepth="2" BlurRadius="8" Opacity="0.40"/>
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock Text="نظام إدارة مراكز صيانة السيارات - تسجيل الدخول" FontSize="12.5" Foreground="#BAE6FD" 
                               HorizontalAlignment="Center" Margin="0,4,0,16"/>

                    <!-- Error Alert -->
                    <Border Background="#40DC2626" BorderBrush="#DC2626" BorderThickness="1" CornerRadius="10" 
                            Padding="12,8" Margin="0,0,0,12"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="White" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </Border>

                    <!-- Username Field -->
                    <TextBlock Text="اسم المستخدم" FontSize="13" FontWeight="Bold" Foreground="#F0F9FF" Margin="0,0,0,6"/>
                    <TextBox x:Name="usernameTxt" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource GlassInputStyle}" Margin="0,0,0,12"/>

                    <!-- Password Field -->
                    <TextBlock Text="كلمة المرور" FontSize="13" FontWeight="Bold" Foreground="#F0F9FF" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,6">
                        <PasswordBox x:Name="pwdBox" Height="44" FontSize="16" Foreground="White" CaretBrush="#38BDF8" VerticalContentAlignment="Center">
                            <PasswordBox.Template>
                                <ControlTemplate TargetType="PasswordBox">
                                    <Border x:Name="bd" CornerRadius="12" Background="#26FFFFFF" BorderBrush="#4DFFFFFF" BorderThickness="1.5">
                                        <ScrollViewer x:Name="PART_ContentHost" Margin="14,8,42,8" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="BorderBrush" Value="#9038BDF8"/>
                                            <Setter TargetName="bd" Property="Background" Value="#38FFFFFF"/>
                                        </Trigger>
                                        <Trigger Property="IsFocused" Value="True">
                                            <Setter TargetName="bd" Property="BorderBrush" Value="#38BDF8"/>
                                            <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                                            <Setter TargetName="bd" Property="Background" Value="#45FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </PasswordBox.Template>
                        </PasswordBox>
                        <TextBox x:Name="visiblePwdBox" Height="44" FontSize="15" Foreground="White" CaretBrush="#38BDF8"
                                 VerticalContentAlignment="Center" Visibility="Collapsed" Style="{StaticResource GlassInputStyle}"
                                 Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.Template>
                                <ControlTemplate TargetType="TextBox">
                                    <Border x:Name="bd" CornerRadius="12" Background="#26FFFFFF" BorderBrush="#4DFFFFFF" BorderThickness="1.5">
                                        <ScrollViewer x:Name="PART_ContentHost" Margin="14,8,42,8" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="BorderBrush" Value="#9038BDF8"/>
                                            <Setter TargetName="bd" Property="Background" Value="#38FFFFFF"/>
                                        </Trigger>
                                        <Trigger Property="IsFocused" Value="True">
                                            <Setter TargetName="bd" Property="BorderBrush" Value="#38BDF8"/>
                                            <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                                            <Setter TargetName="bd" Property="Background" Value="#45FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </TextBox.Template>
                        </TextBox>
                        <Button x:Name="eyeBtn" Width="36" Height="36" Content="👁" FontSize="15" Foreground="#BAE6FD"
                                Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Margin="0,0,6,0" Focusable="False" ToolTip="إظهار / إخفاء كلمة المرور"/>
                    </Grid>

                    <!-- Show Password CheckBox -->
                    <CheckBox x:Name="showPwdChk" Content="إظهار كلمة المرور" FontSize="12.5" Foreground="#BAE6FD" Margin="0,4,0,14" 
                              Cursor="Hand" HorizontalAlignment="Right" IsChecked="{Binding IsPasswordVisible}"/>

                    <!-- Login Button -->
                    <Button Content="تسجيل الدخول" Height="46" FontSize="16" FontWeight="Bold" Foreground="White" Cursor="Hand"
                            Template="{StaticResource LoginBtnTemplate}" Command="{Binding LoginCommand}">
                        <Button.Effect>
                            <DropShadowEffect Color="#0284C7" Direction="270" ShadowDepth="4" BlurRadius="18" Opacity="0.60"/>
                        </Button.Effect>
                    </Button>

                    <!-- Server Settings Pill Button -->
                    <Button Content="⚙ إعدادات خادم قاعدة البيانات" FontSize="12" FontWeight="Medium" Foreground="#BAE6FD"
                            Cursor="Hand" HorizontalAlignment="Center" Margin="0,14,0,0" Padding="14,6,14,6"
                            Template="{StaticResource PillBtnTemplate}" Command="{Binding OpenServerSettingsCommand}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
