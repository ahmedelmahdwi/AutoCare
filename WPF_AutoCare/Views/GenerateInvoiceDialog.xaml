<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إصدار الفاتورة الضريبية النهائية"
        Width="1060" Height="780"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI, Tahoma, Arial"
        Background="{DynamicResource BackgroundBrush}">

    <Window.Resources>
        <Style x:Key="DialogActionBtn" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="14.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#0284C7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,0,20,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#38BDF8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0369A1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="12" Margin="16" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Customer & Order Information Summary -->
            <Border Grid.Row="0" Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="رقم الكرت:" FontSize="11" Foreground="#64748B"/>
                        <TextBlock Text="{Binding RepairOrderNumber}" FontSize="14" FontWeight="Bold" Foreground="#0284C7"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="اسم العميل:" FontSize="11" Foreground="#64748B"/>
                        <TextBlock Text="{Binding CustomerName}" FontSize="13.5" FontWeight="SemiBold" Foreground="#0F172A"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="رقم الهاتف:" FontSize="11" Foreground="#64748B"/>
                        <TextBlock Text="{Binding CustomerPhone}" FontSize="13.5" Foreground="#0F172A"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3">
                        <TextBlock Text="رقم اللوحة:" FontSize="11" Foreground="#64748B"/>
                        <TextBlock Text="{Binding PlateNumber}" FontSize="14" FontWeight="Bold" Foreground="#0F172A"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Line Items Grid (Services & Parts) -->
            <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Margin="0,0,0,14">
                <DataGrid ItemsSource="{Binding InvoiceItems}" AutoGenerateColumns="False" IsReadOnly="True"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                          RowHeight="38" FontSize="13" BorderThickness="0" Background="Transparent">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="النوع" Binding="{Binding ItemType}" Width="100"/>
                        <DataGridTextColumn Header="الوصف / البند" Binding="{Binding Description}" Width="*"/>
                        <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity}" Width="80"/>
                        <DataGridTextColumn Header="سعر الوحدة" Binding="{Binding UnitPriceFormatted}" Width="120"/>
                        <DataGridTextColumn Header="الإجمالي" Binding="{Binding TotalPriceFormatted}" Width="130"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Totals & Payment Method Section -->
            <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="280"/>
                    </Grid.ColumnDefinitions>

                    <!-- Payment Method Selection -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="طريقة الدفع:" FontSize="13" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                        <ComboBox SelectedItem="{Binding SelectedPaymentMethod}" Width="220" Height="38" HorizontalAlignment="Left">
                            <ComboBoxItem Content="نقد (Cash)" IsSelected="True"/>
                            <ComboBoxItem Content="شبكة / مدى (POS)"/>
                            <ComboBoxItem Content="تحويل بنكي (Bank Transfer)"/>
                            <ComboBoxItem Content="آجل / ذمم (Credit)"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Financial Summary Box -->
                    <StackPanel Grid.Column="1">
                        <Grid Margin="0,3">
                            <TextBlock Text="المجموع قبل الضريبة:" FontSize="13" Foreground="#64748B"/>
                            <TextBlock Text="{Binding SubTotalFormatted}" FontSize="13.5" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="#0F172A"/>
                        </Grid>
                        <Grid Margin="0,3">
                            <TextBlock Text="الخصم (د.ل):" FontSize="13" Foreground="#64748B" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding Discount, UpdateSourceTrigger=PropertyChanged}" Width="100" Height="30" HorizontalAlignment="Right" VerticalContentAlignment="Center" TextAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,3">
                            <TextBlock Text="ضريبة القيمة المضافة (15%):" FontSize="13" Foreground="#64748B"/>
                            <TextBlock Text="{Binding TaxAmountFormatted}" FontSize="13.5" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="#0284C7"/>
                        </Grid>
                        <Separator Margin="0,6"/>
                        <Grid Margin="0,3">
                            <TextBlock Text="الصافي النهائي المطلوب:" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="{Binding NetTotalFormatted}" FontSize="17" FontWeight="Bold" HorizontalAlignment="Right" Foreground="#10B981"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Bottom Actions Footer -->
            <Border Grid.Row="3" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,14,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="💾  إصدار وحفظ الفاتورة النهائية" Style="{StaticResource BtnDialogSave}" 
                            Command="{Binding GenerateInvoiceCommand}"/>
                    <Button Content="✕  إلغاء الأمر" Style="{StaticResource BtnDialogCancel}" 
                            Command="{Binding CancelCommand}" IsCancel="True" Margin="12,0,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
