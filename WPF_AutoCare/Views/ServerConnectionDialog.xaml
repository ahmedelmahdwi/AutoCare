<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إعدادات الاتصال بخادم SQL Server - AutoCare" Width="520" Height="580"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI, Tahoma, Arial"
        Background="{DynamicResource BackgroundBrush}">

    <Window.Resources>
        <Style x:Key="DlgInputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="0,4,0,12"/>
        </Style>

        <Style x:Key="DlgPasswordStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="0,4,0,12"/>
        </Style>

        <!-- Primary Blue Button (Test & Init) -->
        <Style x:Key="BtnDialogPrimary" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinWidth" Value="150"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#0284C7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#38BDF8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0369A1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#94A3B8"/>
                                <Setter Property="Foreground" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Save Green Button -->
        <Style x:Key="BtnDialogSave" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinWidth" Value="130"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#34D399"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#059669"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#CBD5E1"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cancel Slate Button -->
        <Style x:Key="BtnDialogCancel" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinWidth" Value="95"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="إعدادات الاتصال بخادم SQL Server" FontSize="19" FontWeight="Bold" Foreground="#0F172A"/>
            <TextBlock Text="يمكنك تحديد خادم SQL محلي أو عبر الشبكة، وسيتم التحقق من القاعدة وتهيئتها تلقائياً." FontSize="12.5" Foreground="#64748B" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Main Form Card -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="اسم السيرفر / الخادم (Server Name):" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155"/>
                    <TextBox x:Name="TxtServer" Text=".\SQLEXPRESS" Style="{StaticResource DlgInputStyle}"/>

                    <TextBlock Text="نوع المصادقة (Authentication):" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                    <RadioButton x:Name="RadioWinAuth" Content="Windows Authentication (المصادقة المتكاملة - افتراضي)" IsChecked="True" FontSize="12" Margin="0,0,0,6" Cursor="Hand"/>
                    <RadioButton x:Name="RadioSqlAuth" Content="SQL Server Authentication (اسم المستخدم وكلمة المرور)" FontSize="12" Margin="0,0,0,12" Cursor="Hand"/>

                    <!-- SQL Auth Credentials Panel -->
                    <StackPanel x:Name="PanelSqlAuth" Visibility="Collapsed" Margin="0,0,0,6">
                        <TextBlock Text="اسم المستخدم (Username):" FontSize="12" Foreground="#475569"/>
                        <TextBox x:Name="TxtUser" Text="sa" Style="{StaticResource DlgInputStyle}"/>

                        <TextBlock Text="كلمة المرور (Password):" FontSize="12" Foreground="#475569"/>
                        <PasswordBox x:Name="TxtPassword" Style="{StaticResource DlgPasswordStyle}"/>
                    </StackPanel>

                    <!-- Status Display -->
                    <TextBlock x:Name="TxtStatus" Text="" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="#64748B"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Actions Footer -->
        <Border Grid.Row="2" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnTestConn" Content="🔌 فحص وتهيئة القاعدة" Style="{StaticResource BtnDialogPrimary}" Grid.Column="0" HorizontalAlignment="Left"/>
                <Button x:Name="BtnSave" Content="💾  حفظ ومتابعة" Style="{StaticResource BtnDialogSave}" Grid.Column="1" Margin="12,0,0,0" IsEnabled="False"/>
                <Button x:Name="BtnCancel" Content="✕  إلغاء" Style="{StaticResource BtnDialogCancel}" Grid.Column="2" Margin="12,0,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
