<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             FontFamily="Segoe UI, Tahoma, Arial"
             Background="{DynamicResource BackgroundBrush}">

    <UserControl.Resources>
        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#0284C7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#38BDF8"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="#0369A1"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnDanger" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#EF4444"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#F87171"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="#DC2626"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. Header Title & Top Actions -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🗑️" FontSize="26" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="سلة المحذوفات والأرشيف الإداري (Recycle Bin)" FontSize="22" FontWeight="Bold" FontFamily="{StaticResource HeaderFontFamily}" Foreground="#0F172A" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="إدارة السجلات المحذوفة مرناً: استعادتها للعمل فوراً أو محوها نهائياً مع حماية الحسابات التاريخية." FontSize="13" Foreground="#64748B" Margin="36,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="🔄 تحديث" Command="{Binding RefreshCommand}" Style="{StaticResource BtnPrimary}" Margin="0,0,10,0"/>
                <Button Content="🧹 تفريغ المحذوفات المؤهلة" Command="{Binding PurgeAllEligibleCommand}" Style="{StaticResource BtnDanger}"/>
            </StackPanel>
        </Grid>

        <!-- 2. Statistics KPI Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Total Deleted -->
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="إجمالي السجلات في سلة المحذوفات" FontSize="12.5" Foreground="#64748B" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding TotalDeletedCount}" FontSize="24" FontWeight="Bold" Foreground="#0284C7" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 2: Eligible for Purge -->
            <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="5,0,5,0">
                <StackPanel>
                    <TextBlock Text="جاهزة للحذف النهائي الآمن (بلا ارتباطات)" FontSize="12.5" Foreground="#64748B" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding EligibleForPurgeCount}" FontSize="24" FontWeight="Bold" Foreground="#10B981" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 3: Protected Historical Records -->
            <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="سجلات محمية محاسبياً (مرتبطة بفواتير/صيانة)" FontSize="12.5" Foreground="#64748B" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding ProtectedCount}" FontSize="24" FontWeight="Bold" Foreground="#EF4444" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 3. Search and Filtering Toolbar -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search Input -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🔍 بحث:" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#334155"/>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="280" Height="36" FontSize="13.5" VerticalContentAlignment="Center" Padding="8,0"/>
                </StackPanel>

                <!-- Type Filter Radio/ComboBox -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="تصفية حسب النوع:" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#334155"/>
                    <ComboBox SelectedValue="{Binding SelectedFilter}" SelectedValuePath="Content" Width="140" Height="36" VerticalContentAlignment="Center">
                        <ComboBoxItem Content="الكل" IsSelected="True"/>
                        <ComboBoxItem Content="العملاء"/>
                        <ComboBoxItem Content="المركبات"/>
                        <ComboBoxItem Content="الحجوزات"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 4. DataGrid of Deleted Items -->
        <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="0" ClipToBounds="True">
            <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                      AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#F1F5F9" RowHeight="46"
                      Background="#FFFFFF" BorderThickness="0"
                      SelectionMode="Single" SelectionUnit="FullRow">
                
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Height" Value="42"/>
                        <Setter Property="Background" Value="#F8FAFC"/>
                        <Setter Property="Foreground" Value="#334155"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="Padding" Value="12,0"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <!-- Type Badge -->
                    <DataGridTemplateColumn Header="النوع" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#F1F5F9" CornerRadius="6" Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ItemType}" FontWeight="Bold" FontSize="12" Foreground="{Binding TypeBadgeColor}"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Key Identifier -->
                    <DataGridTextColumn Header="المعرّف (الهاتف / اللوحة / الموعد)" Binding="{Binding Key}" Width="180">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="12,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Display Name & Details -->
                    <DataGridTemplateColumn Header="الاسم والبيانات" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center" Margin="10,0">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13" Foreground="#1E293B"/>
                                    <TextBlock Text="{Binding Details}" FontSize="11.5" Foreground="#64748B"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Date -->
                    <DataGridTextColumn Header="تاريخ الأرشفة" Binding="{Binding FormattedDate}" Width="140">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#475569"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="10,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Safety Status Badge -->
                    <DataGridTemplateColumn Header="حالة الأمان والحذف النهائي" Width="260">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding StatusBadgeBackground}" BorderBrush="{Binding StatusBadgeBorder}" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="8,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding StatusReason}" FontSize="11.5" FontWeight="SemiBold" Foreground="{Binding StatusBadgeColor}"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Actions Buttons (Restore & Purge) -->
                    <DataGridTemplateColumn Header="الإجراءات" Width="180">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <!-- Restore Button -->
                                    <Button Content="🟢 استعادة" Width="72" Height="30" FontSize="11.5" FontWeight="Bold" Margin="0,0,6,0"
                                            Background="#10B981" Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand"
                                            Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#34D399"/></Trigger>
                                                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="#059669"/></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <!-- Purge Button -->
                                    <Button Content="🔴 حذف نهائي" Width="78" Height="30" FontSize="11.5" FontWeight="Bold"
                                            Background="#EF4444" Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand"
                                            Command="{Binding DataContext.PurgeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#F87171"/></Trigger>
                                                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="#DC2626"/></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
