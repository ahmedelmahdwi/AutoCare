<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             FontFamily="Segoe UI, Tahoma, Arial"
             Background="{DynamicResource BackgroundBrush}">

    <UserControl.Resources>
        <!-- Top Toolbar Ghost Button -->
        <Style x:Key="GhostBtnStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Width" Value="125"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#0284C7"/>
            <Setter Property="Background" Value="#F0F9FF"/>
            <Setter Property="BorderBrush" Value="#BAE6FD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E0F2FE"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#38BDF8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#BAE6FD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Base Card Button Settings -->
        <Style x:Key="BaseDashboardCardBtn" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="MinHeight" Value="130"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        </Style>

        <!-- 1. Amber Card (قطع الغيار قرب الحد الأدنى) -->
        <Style x:Key="CardAmberBtn" TargetType="Button" BasedOn="{StaticResource BaseDashboardCardBtn}">
            <Setter Property="ToolTip" Value="انقر للانتقال إلى شاشة قطع الغيار وإدارة النواقص"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="16" BorderThickness="1.5" BorderBrush="#F59E0B" Padding="18,16" SnapsToDevicePixels="True">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FEF3C7" Offset="0.0"/>
                                    <GradientStop Color="#FDE68A" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#0F172A" Direction="270" ShadowDepth="3" BlurRadius="10" Opacity="0.08"/>
                            </Border.Effect>
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#FDE68A" Offset="0.0"/>
                                            <GradientStop Color="#FCD34D" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#D97706"/>
                                <Setter TargetName="bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#0F172A" Direction="270" ShadowDepth="6" BlurRadius="16" Opacity="0.22"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.92"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 2. Sky Blue Card (السيارات بانتظار المعالجة) -->
        <Style x:Key="CardSkyBtn" TargetType="Button" BasedOn="{StaticResource BaseDashboardCardBtn}">
            <Setter Property="ToolTip" Value="انقر للانتقال إلى كروت الصيانة لمتابعة السيارات المعلقة"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="16" BorderThickness="1.5" BorderBrush="#0284C7" Padding="18,16" SnapsToDevicePixels="True">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#E0F2FE" Offset="0.0"/>
                                    <GradientStop Color="#BAE6FD" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#0F172A" Direction="270" ShadowDepth="3" BlurRadius="10" Opacity="0.08"/>
                            </Border.Effect>
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#BAE6FD" Offset="0.0"/>
                                            <GradientStop Color="#7DD3FC" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#0369A1"/>
                                <Setter TargetName="bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#0F172A" Direction="270" ShadowDepth="6" BlurRadius="16" Opacity="0.22"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.92"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 3. Emerald Green Card (السيارات المكتملة) -->
        <Style x:Key="CardEmeraldBtn" TargetType="Button" BasedOn="{StaticResource BaseDashboardCardBtn}">
            <Setter Property="ToolTip" Value="انقر للانتقال إلى الفواتير لإصدار فواتير السيارات المكتملة"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="16" BorderThickness="1.5" BorderBrush="#10B981" Padding="18,16" SnapsToDevicePixels="True">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#DCFCE7" Offset="0.0"/>
                                    <GradientStop Color="#BBF7D0" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#0F172A" Direction="270" ShadowDepth="3" BlurRadius="10" Opacity="0.08"/>
                            </Border.Effect>
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#BBF7D0" Offset="0.0"/>
                                            <GradientStop Color="#86EFAC" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#059669"/>
                                <Setter TargetName="bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#0F172A" Direction="270" ShadowDepth="6" BlurRadius="16" Opacity="0.22"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.92"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 4. Purple Violet Card (صافي الربح اليوم) -->
        <Style x:Key="CardPurpleBtn" TargetType="Button" BasedOn="{StaticResource BaseDashboardCardBtn}">
            <Setter Property="ToolTip" Value="انقر للانتقال إلى شاشة التقارير المالية التفصيلية"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="16" BorderThickness="1.5" BorderBrush="#A855F7" Padding="18,16" SnapsToDevicePixels="True">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#F3E8FF" Offset="0.0"/>
                                    <GradientStop Color="#E9D5FF" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#0F172A" Direction="270" ShadowDepth="3" BlurRadius="10" Opacity="0.08"/>
                            </Border.Effect>
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#E9D5FF" Offset="0.0"/>
                                            <GradientStop Color="#D8B4FE" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#9333EA"/>
                                <Setter TargetName="bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#0F172A" Direction="270" ShadowDepth="6" BlurRadius="16" Opacity="0.22"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.92"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 5. Cyan Card (السيارات قيد التنفيذ) -->
        <Style x:Key="CardCyanBtn" TargetType="Button" BasedOn="{StaticResource BaseDashboardCardBtn}">
            <Setter Property="ToolTip" Value="انقر للانتقال إلى شاشة الصيانة لمتابعة السيارات الجاري صيانتها"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="16" BorderThickness="1.5" BorderBrush="#06B6D4" Padding="18,16" SnapsToDevicePixels="True">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#CFFAFE" Offset="0.0"/>
                                    <GradientStop Color="#A5F3FC" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#0F172A" Direction="270" ShadowDepth="3" BlurRadius="10" Opacity="0.08"/>
                            </Border.Effect>
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#A5F3FC" Offset="0.0"/>
                                            <GradientStop Color="#67E8F9" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#0891B2"/>
                                <Setter TargetName="bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#0F172A" Direction="270" ShadowDepth="6" BlurRadius="16" Opacity="0.22"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.92"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 6. Royal Blue Card (مبيعات اليوم) -->
        <Style x:Key="CardRoyalBtn" TargetType="Button" BasedOn="{StaticResource BaseDashboardCardBtn}">
            <Setter Property="ToolTip" Value="انقر للانتقال إلى أرشيف الفواتير"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="16" BorderThickness="1.5" BorderBrush="#3B82F6" Padding="18,16" SnapsToDevicePixels="True">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#DBEAFE" Offset="0.0"/>
                                    <GradientStop Color="#BFDBFE" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#0F172A" Direction="270" ShadowDepth="3" BlurRadius="10" Opacity="0.08"/>
                            </Border.Effect>
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#BFDBFE" Offset="0.0"/>
                                            <GradientStop Color="#93C5FD" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#1D4ED8"/>
                                <Setter TargetName="bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#0F172A" Direction="270" ShadowDepth="6" BlurRadius="16" Opacity="0.22"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.92"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Column Bar Style with Smooth Hover Animation -->
        <Style x:Key="RevenueColumnBarStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="8,8,2,2"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#0284C7" Offset="0.0"/>
                        <GradientStop Color="#0369A1" Offset="1.0"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#0284C7" Direction="270" ShadowDepth="2" BlurRadius="8" Opacity="0.25"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#38BDF8" Offset="0.0"/>
                                <GradientStop Color="#0284C7" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#0284C7" Direction="270" ShadowDepth="4" BlurRadius="16" Opacity="0.5"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title & Refresh Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,0,2,14">
            <TextBlock Text="لوحة التحكم التشغيلية" FontSize="24" FontWeight="Bold" FontFamily="{StaticResource HeaderFontFamily}" Foreground="#0F172A" VerticalAlignment="Center"/>
            <Button Content="🔄  تحديث الآن" Style="{StaticResource GhostBtnStyle}" Command="{Binding RefreshCommand}" Margin="16,0,0,0"/>
            <TextBlock Text="{Binding LastUpdate}" FontSize="13" Foreground="#64748B" VerticalAlignment="Center" Margin="14,0,0,0"/>
        </StackPanel>

        <!-- Scrollable Dashboard Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
            <StackPanel>
                <!-- ═══════════════════════════════════════════════════════════ -->
                <!-- 1. 6 KPI Operational & Financial Cards Grid                -->
                <!-- ═══════════════════════════════════════════════════════════ -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Card 1: قطع الغيار قرب الحد الأدنى (Row 0, Col 0 - Amber) -->
                    <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource CardAmberBtn}"
                            Command="{Binding NavigateCommand}" CommandParameter="قطع الغيار:نواقص">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="قطع الغيار قرب الحد الأدنى" FontSize="16" FontWeight="Bold" Foreground="#78350F" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Background="#33F59E0B" CornerRadius="12" Width="36" Height="36">
                                    <TextBlock Text="⚠️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,12,0,10">
                                <TextBlock Text="{Binding LowStockCount}" FontSize="38" FontWeight="Bold" Foreground="#B45309" VerticalAlignment="Bottom"/>
                                <TextBlock Text=" قطعة" FontSize="14" FontWeight="SemiBold" Foreground="#92400E" Margin="8,0,0,6" VerticalAlignment="Bottom"/>
                            </StackPanel>
                            <Border Grid.Row="2" Background="#26F59E0B" CornerRadius="8" Padding="10,5" HorizontalAlignment="Left">
                                <TextBlock Text="عرض وإدارة النواقص  ⮌" FontSize="12" FontWeight="Bold" Foreground="#92400E"/>
                            </Border>
                        </Grid>
                    </Button>

                    <!-- Card 2: السيارات بانتظار المعالجة (Row 0, Col 1 - Sky Blue) -->
                    <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource CardSkyBtn}"
                            Command="{Binding NavigateCommand}" CommandParameter="حالة السيارات:معلق">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="السيارات بانتظار المعالجة" FontSize="16" FontWeight="Bold" Foreground="#0C4A6E" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Background="#330284C7" CornerRadius="12" Width="36" Height="36">
                                    <TextBlock Text="⏳" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,12,0,10">
                                <TextBlock Text="{Binding PendingCount}" FontSize="38" FontWeight="Bold" Foreground="#0284C7" VerticalAlignment="Bottom"/>
                                <TextBlock Text=" سيارة" FontSize="14" FontWeight="SemiBold" Foreground="#0369A1" Margin="8,0,0,6" VerticalAlignment="Bottom"/>
                            </StackPanel>
                            <Border Grid.Row="2" Background="#260284C7" CornerRadius="8" Padding="10,5" HorizontalAlignment="Left">
                                <TextBlock Text="بدء فحص وصيانة السيارات  ⮌" FontSize="12" FontWeight="Bold" Foreground="#0369A1"/>
                            </Border>
                        </Grid>
                    </Button>

                    <!-- Card 3: السيارات المكتملة (Row 0, Col 2 - Emerald Green) -->
                    <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource CardEmeraldBtn}"
                            Command="{Binding NavigateCommand}" CommandParameter="حالة السيارات:مكتمل">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="السيارات المكتملة" FontSize="16" FontWeight="Bold" Foreground="#064E3B" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Background="#3310B981" CornerRadius="12" Width="36" Height="36">
                                    <TextBlock Text="✅" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,12,0,10">
                                <TextBlock Text="{Binding CompletedCount}" FontSize="38" FontWeight="Bold" Foreground="#059669" VerticalAlignment="Bottom"/>
                                <TextBlock Text=" سيارة" FontSize="14" FontWeight="SemiBold" Foreground="#047857" Margin="8,0,0,6" VerticalAlignment="Bottom"/>
                            </StackPanel>
                            <Border Grid.Row="2" Background="#2610B981" CornerRadius="8" Padding="10,5" HorizontalAlignment="Left">
                                <TextBlock Text="عرض كافة السيارات المكتملة  ⮌" FontSize="12" FontWeight="Bold" Foreground="#047857"/>
                            </Border>
                        </Grid>
                    </Button>

                    <!-- Card 4: صافي الربح اليوم (Row 1, Col 0 - Purple Violet) -->
                    <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource CardPurpleBtn}"
                            Command="{Binding NavigateCommand}" CommandParameter="التقارير:today">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="صافي الربح اليوم" FontSize="16" FontWeight="Bold" Foreground="#581C87" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Background="#33A855F7" CornerRadius="12" Width="36" Height="36">
                                    <TextBlock Text="📈" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,12,0,10">
                                <TextBlock Text="{Binding NetProfitFormatted}" FontSize="32" FontWeight="Bold" Foreground="#7E22CE" VerticalAlignment="Bottom"/>
                            </StackPanel>
                            <Border Grid.Row="2" Background="#26A855F7" CornerRadius="8" Padding="10,5" HorizontalAlignment="Left">
                                <TextBlock Text="عرض تقرير أرباح اليوم  ⮌" FontSize="12" FontWeight="Bold" Foreground="#6B21A8"/>
                            </Border>
                        </Grid>
                    </Button>

                    <!-- Card 5: السيارات قيد التنفيذ (Row 1, Col 1 - Cyan) -->
                    <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource CardCyanBtn}"
                            Command="{Binding NavigateCommand}" CommandParameter="حالة السيارات:قيد التنفيذ">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="السيارات قيد التنفيذ" FontSize="16" FontWeight="Bold" Foreground="#164E63" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Background="#3306B6D4" CornerRadius="12" Width="36" Height="36">
                                    <TextBlock Text="🔧" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,12,0,10">
                                <TextBlock Text="{Binding InProgressCount}" FontSize="38" FontWeight="Bold" Foreground="#0891B2" VerticalAlignment="Bottom"/>
                                <TextBlock Text=" سيارة" FontSize="14" FontWeight="SemiBold" Foreground="#0E7490" Margin="8,0,0,6" VerticalAlignment="Bottom"/>
                            </StackPanel>
                            <Border Grid.Row="2" Background="#2606B6D4" CornerRadius="8" Padding="10,5" HorizontalAlignment="Left">
                                <TextBlock Text="متابعة مراحل الصيانة  ⮌" FontSize="12" FontWeight="Bold" Foreground="#0E7490"/>
                            </Border>
                        </Grid>
                    </Button>

                    <!-- Card 6: مبيعات اليوم (Row 1, Col 2 - Royal Blue) -->
                    <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource CardRoyalBtn}"
                            Command="{Binding NavigateCommand}" CommandParameter="التقارير:today">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="مبيعات اليوم" FontSize="16" FontWeight="Bold" Foreground="#1E3A8A" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Background="#333B82F6" CornerRadius="12" Width="36" Height="36">
                                    <TextBlock Text="💳" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,12,0,10">
                                <TextBlock Text="{Binding TodaySalesFormatted}" FontSize="32" FontWeight="Bold" Foreground="#1D4ED8" VerticalAlignment="Bottom"/>
                            </StackPanel>
                            <Border Grid.Row="2" Background="#263B82F6" CornerRadius="8" Padding="10,5" HorizontalAlignment="Left">
                                <TextBlock Text="عرض تقرير مبيعات وفواتير اليوم  ⮌" FontSize="12" FontWeight="Bold" Foreground="#1E40AF"/>
                            </Border>
                        </Grid>
                    </Button>
                </Grid>

                <!-- ═══════════════════════════════════════════════════════════ -->
                <!-- 2. Interactive Vector Charts Section (Dual Columns)         -->
                <!-- ═══════════════════════════════════════════════════════════ -->
                <Grid Margin="6,6,6,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.4*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 2.1 Left: Monthly Revenue Column Chart (مخطط الإيرادات الشهرية) -->
                    <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" Padding="18" SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect Color="#0F172A" Direction="270" ShadowDepth="3" BlurRadius="10" Opacity="0.06"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="210"/>
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📊" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="تطور الإيرادات الشهرية (آخر 6 أشهر)" FontSize="16.5" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="مقارنة المبالغ المحصلة فعلياً بالدينار الليبي (د.ل)" FontSize="12.5" Foreground="#64748B" Margin="28,2,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="8" Padding="10,4" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="الذروة: " FontSize="12" Foreground="#0284C7"/>
                                        <TextBlock Text="{Binding MaxMonthlyRevenueFormatted}" FontSize="12.5" FontWeight="Bold" Foreground="#0284C7"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Separator Grid.Row="1" Margin="0,12,0,14" Background="#F1F5F9"/>

                            <!-- Native Clean Vector Bar Chart -->
                            <Grid Grid.Row="2">
                                <!-- Subtle Background Grid Guidelines -->
                                <Grid VerticalAlignment="Stretch" Margin="0,0,0,26">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1"/>
                                    <Border Grid.Row="1" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1"/>
                                    <Border Grid.Row="2" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1.5"/>
                                </Grid>

                                <!-- Revenue Bars ItemsControl -->
                                <ItemsControl ItemsSource="{Binding MonthlyRevenues}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid VerticalAlignment="Stretch" Margin="4,0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="26"/>
                                                </Grid.RowDefinitions>

                                                <!-- The Vector Column Bar with Value Text -->
                                                <Grid Grid.Row="0" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                                        <TextBlock Text="{Binding ShortRevenueDisplay}"
                                                                   FontSize="10.5" FontWeight="Bold"
                                                                   Foreground="#0284C7"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="0,0,0,4"/>
                                                        <Border Style="{StaticResource RevenueColumnBarStyle}"
                                                                Width="38"
                                                                Height="{Binding BarHeight}">
                                                            <!-- Interactive Tooltip with Rich Libyan Dinar Formatting -->
                                                            <Border.ToolTip>
                                                                <ToolTip Background="Transparent" BorderThickness="0" Padding="0">
                                                                    <Border Background="#0F172A" BorderBrush="#38BDF8" BorderThickness="1.5" CornerRadius="8" Padding="12,8">
                                                                        <StackPanel>
                                                                            <TextBlock Text="{Binding MonthNameArabic}" FontSize="13" FontWeight="Bold" Foreground="#38BDF8"/>
                                                                            <TextBlock Text="{Binding MonthPeriod}" FontSize="11" Foreground="#94A3B8" Margin="0,1,0,4"/>
                                                                            <TextBlock Text="{Binding TotalRevenueFormatted}" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </ToolTip>
                                                            </Border.ToolTip>
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Month Name Arabic Label Below Bar -->
                                                <TextBlock Grid.Row="1" Text="{Binding MonthNameArabic}"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           Foreground="#475569"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- 2.2 Right: Order Status Distribution & Health (توزيع حالات الأوامر) -->
                    <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" Padding="18" SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect Color="#0F172A" Direction="270" ShadowDepth="3" BlurRadius="10" Opacity="0.06"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🎯" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="توزيع حالات كروت الصيانة" FontSize="16.5" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="نسب الأوامر النشطة والمنجزة" FontSize="12.5" Foreground="#64748B" Margin="28,2,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="8" Padding="10,4" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="الإجمالي: " FontSize="12" Foreground="#059669"/>
                                        <TextBlock Text="{Binding TotalOrdersInDistribution}" FontSize="12.5" FontWeight="Bold" Foreground="#059669"/>
                                        <TextBlock Text=" كرت" FontSize="11.5" Foreground="#059669" Margin="3,0,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Separator Grid.Row="1" Margin="0,12,0,12" Background="#F1F5F9"/>

                            <!-- Status Breakdown Cards List (Clickable & Interactive) -->
                            <ItemsControl Grid.Row="2" ItemsSource="{Binding StatusDistributions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Margin="0,0,0,8" Padding="10,8" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                                                Cursor="Hand" ToolTip="انقر للانتقال إلى كروت الصيانة وتصفية هذه الحالة"
                                                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding StatusArabic, StringFormat='حالة السيارات:{0}'}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="itemBd" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="itemBd" Property="Background" Value="#F1F5F9"/>
                                                            <Setter TargetName="itemBd" Property="BorderBrush" Value="#94A3B8"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- Status Color Pill -->
                                                <Border Grid.Column="0" Width="10" Height="10" CornerRadius="5" Background="{Binding ColorHex}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                <!-- Status Arabic Name -->
                                                <TextBlock Grid.Column="1" Text="{Binding StatusArabic}" FontSize="13.5" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                                                <!-- Count Badge -->
                                                <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Count, StringFormat='{}{0} سيارة'}" FontSize="12" FontWeight="SemiBold" Foreground="#334155"/>
                                                </Border>
                                                <!-- Percentage -->
                                                <TextBlock Grid.Column="3" Text="{Binding PercentageFormatted}" FontSize="13" FontWeight="Bold" Foreground="{Binding ColorHex}" VerticalAlignment="Center" Width="48" TextAlignment="Left"/>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ═══════════════════════════════════════════════════════════ -->
                <!-- 3. Top 5 Services List (أكثر الخدمات طلباً وإيراداً)         -->
                <!-- ═══════════════════════════════════════════════════════════ -->
                <Border Margin="6,0,6,18" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" Padding="18" SnapsToDevicePixels="True">
                    <Border.Effect>
                        <DropShadowEffect Color="#0F172A" Direction="270" ShadowDepth="3" BlurRadius="10" Opacity="0.06"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⭐" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="أكثر 5 خدمات صيانة طلباً وتحقيقاً للإيراد" FontSize="16.5" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="مؤشرات أداء ورشة العمل والأعمال المنجزة" FontSize="12.5" Foreground="#64748B" Margin="28,2,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Separator Grid.Row="1" Margin="0,12,0,12" Background="#F1F5F9"/>

                        <!-- Top Services Horizontal / Grid Cards -->
                        <ItemsControl Grid.Row="2" ItemsSource="{Binding TopServices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8" Padding="14,10" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- Rank Badge -->
                                            <Border Grid.Column="0" Background="#3B82F6" CornerRadius="14" Width="28" Height="28" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Rank}" FontSize="12.5" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <!-- Service Name -->
                                            <TextBlock Grid.Column="1" Text="{Binding ServiceName}" FontSize="14" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                            <!-- Usage Count -->
                                            <Border Grid.Column="2" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="10,3" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding UsageCount, StringFormat='{}{0} عملية إنجاز'}" FontSize="12.5" FontWeight="SemiBold" Foreground="#1D4ED8"/>
                                            </Border>
                                            <!-- Total Income in Libyan Dinar -->
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="الإجمالي: " FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding TotalIncomeFormatted}" FontSize="14.5" FontWeight="Bold" Foreground="#059669" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
