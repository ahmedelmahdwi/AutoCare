<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             FontFamily="Segoe UI, Tahoma, Arial"
             Background="{DynamicResource BackgroundBrush}">

    <UserControl.Resources>
        <!-- Primary Action Button -->
        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#0284C7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#38BDF8"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="#0369A1"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ghost Action Button -->
        <Style x:Key="BtnGhost" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#0284C7"/>
            <Setter Property="Background" Value="#F0F9FF"/>
            <Setter Property="BorderBrush" Value="#BAE6FD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#E0F2FE"/><Setter TargetName="bd" Property="BorderBrush" Value="#38BDF8"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="#BAE6FD"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Success Green Button -->
        <Style x:Key="BtnSuccess" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#34D399"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="#059669"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cyan Button -->
        <Style x:Key="BtnCyan" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
            <Setter Property="Background" Value="#06B6D4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#22D3EE"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="#0891B2"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Warning Amber Button (Cancel Order) -->
        <Style x:Key="BtnWarning" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
            <Setter Property="Background" Value="#F59E0B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#FBBF24"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="#D97706"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger Red Button (Admin Hard Delete) -->
        <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
            <Setter Property="Background" Value="#EF4444"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#F87171"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="#DC2626"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title Row -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,0,2,12">
            <TextBlock Text="حالة السيارات" FontSize="24" FontWeight="Bold" FontFamily="{StaticResource HeaderFontFamily}" Foreground="#0F172A"/>
        </StackPanel>

        <!-- Toolbar (Exact duplicate of CarStatusScreen toolbar) -->
        <DockPanel Grid.Row="1" Margin="0,0,0,2">
            <!-- Search on Right -->
            <TextBox DockPanel.Dock="Right" Width="240" Height="38" FontSize="13.5" VerticalContentAlignment="Center"
                     Padding="10,0" Margin="0,0,0,0"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

            <!-- Filter Combo on Right -->
            <ComboBox DockPanel.Dock="Right" Width="130" Height="38" FontSize="13.5" Margin="10,0,10,0"
                      SelectedValuePath="Content" SelectedValue="{Binding SelectedFilter}">
                <ComboBoxItem Content="الكل" IsSelected="True"/>
                <ComboBoxItem Content="معلق"/>
                <ComboBoxItem Content="قيد التنفيذ"/>
                <ComboBoxItem Content="مكتمل"/>
                <ComboBoxItem Content="ملغى"/>
            </ComboBox>

            <!-- Action Buttons on Left -->
            <Button DockPanel.Dock="Left" Content="+ إضافة خدمات" Command="{Binding AddServicesCommand}" Width="130" Style="{StaticResource BtnPrimary}" Margin="0,0,0,0"/>
            <Button DockPanel.Dock="Left" Content="تعديل" Command="{Binding EditOrderCommand}" Width="80" Style="{StaticResource BtnGhost}" Margin="8,0,0,0"/>
            <Button DockPanel.Dock="Left" Content="إكمال الصيانة" Command="{Binding CompleteOrderCommand}" Width="115" Style="{StaticResource BtnSuccess}" Margin="8,0,0,0"/>
            <Button DockPanel.Dock="Left" Content="إلغاء الأمر" Command="{Binding CancelOrderCommand}" Width="100" Style="{StaticResource BtnWarning}" Margin="8,0,0,0"/>
            <Button DockPanel.Dock="Left" Content="حذف (أدمن)" Command="{Binding DeleteOrderCommand}" Width="95" Style="{StaticResource BtnDanger}" Margin="8,0,0,0"/>
            <Button DockPanel.Dock="Left" Content="تفاصيل" Command="{Binding OrderDetailsCommand}" Width="80" Style="{StaticResource BtnCyan}" Margin="8,0,0,0"/>
        </DockPanel>

        <!-- DataGrid in White Rounded Border (Exact duplicate of CarStatusScreen grid) -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E3EAF1" BorderThickness="1" CornerRadius="12" Margin="0,12,0,0" Padding="1">
            <DataGrid ItemsSource="{Binding Orders}" SelectedItem="{Binding SelectedOrder}"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0"
                      RowHeight="42" FontSize="13.5" SelectionMode="Single"
                      BorderThickness="0" Background="Transparent">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="رقم أمر الإصلاح" Binding="{Binding RoNumber}" Width="130"/>
                    <DataGridTextColumn Header="رقم اللوحة" Binding="{Binding PlateNumber}" Width="140"/>
                    <DataGridTextColumn Header="رقم الهيكل (VIN)" Binding="{Binding VIN}" Width="170"/>
                    <DataGridTextColumn Header="اسم السيارة" Binding="{Binding CarName}" Width="150"/>
                    <DataGridTextColumn Header="الموديل" Binding="{Binding CarModel}" Width="100"/>
                    <DataGridTextColumn Header="تاريخ الإدخال" Binding="{Binding EntryDate}" Width="150"/>
                    <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
