<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="معاينة وطباعة التقرير / الفاتورة"
        Width="1050" Height="800"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI, Tahoma, Arial"
        Background="#0F172A">

    <Window.Resources>
        <Style x:Key="PreviewToolbarBtn" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0284C7"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#38BDF8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0369A1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="54"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Fixed Professional Toolbar -->
        <Border Grid.Row="0" Background="#090D16" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="14,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Document Actions (Print / PDF / Word) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="🖨️  طباعة التقرير" Style="{StaticResource PreviewToolbarBtn}" 
                            Command="{Binding PrintCommand}" Background="#0284C7"/>
                    <Button Content="📄  تصدير PDF" Style="{StaticResource PreviewToolbarBtn}" 
                            Command="{Binding ExportPdfCommand}" Background="#10B981"/>
                    <Button Content="📝  تصدير Word" Style="{StaticResource PreviewToolbarBtn}" 
                            Command="{Binding ExportWordCommand}" Background="#2563EB"/>
                </StackPanel>

                <!-- Paging & Zoom Controls -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="◀ السابق" Style="{StaticResource PreviewToolbarBtn}" Command="{Binding PreviousPageCommand}"/>
                    <TextBlock Text="{Binding PageCounterLabel, FallbackValue='صفحة 1 من 1'}" 
                               Foreground="#E2E8F0" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0"/>
                    <Button Content="التالي ▶" Style="{StaticResource PreviewToolbarBtn}" Command="{Binding NextPageCommand}"/>
                    
                    <Separator Margin="14,8" Background="#334155"/>
                    <Button Content="ملائمة الصفحة" Style="{StaticResource PreviewToolbarBtn}" Command="{Binding FitPageCommand}"/>
                    <Button Content="100%" Style="{StaticResource PreviewToolbarBtn}" Command="{Binding ActualSizeCommand}"/>
                </StackPanel>

                <!-- Close Button -->
                <Button Grid.Column="2" Content="إغلاق" Style="{StaticResource PreviewToolbarBtn}" 
                        Command="{Binding CloseCommand}" Background="#F43F5E" BorderThickness="0"/>
            </Grid>
        </Border>

        <!-- Document Canvas Background -->
        <ScrollViewer Grid.Row="1" Background="#1E293B" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Grid MinHeight="800" Margin="30">
                <!-- A4 Document Paper Frame with Elevation Shadow -->
                <Border Width="794" Height="1122" Background="#FFFFFF" CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.4" Color="#000000"/>
                    </Border.Effect>
                    <Image Source="{Binding CurrentPageImage}" Stretch="Uniform" Margin="0"/>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
