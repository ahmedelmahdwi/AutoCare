<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             FontFamily="Segoe UI, Tahoma, Arial"
             Background="{DynamicResource BackgroundBrush}">

    <UserControl.Resources>
        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#0284C7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#38BDF8"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="#0369A1"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnSuccess" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#34D399"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="#059669"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
            <Setter Property="Background" Value="#EF4444"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#F87171"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="#DC2626"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnGhost" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#0284C7"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="BorderBrush" Value="#BAE6FD"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F0F9FF"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#0284C7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E0F2FE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title Row -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,0,2,12">
            <TextBlock Text="إدارة وإصدار الفواتير" FontSize="24" FontWeight="Bold" FontFamily="{StaticResource HeaderFontFamily}" Foreground="#0F172A"/>
        </StackPanel>

        <!-- Main Tab Control -->
        <TabControl Grid.Row="1" SelectedIndex="{Binding ActiveTabIndex, Mode=TwoWay}" Background="Transparent" BorderThickness="0" FontSize="14">

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- Tab 1: أوامر بانتظار الفوترة -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <TabItem Header="📋 أوامر جاهزة للفوترة" Padding="18,10" Visibility="{Binding CreateInvoiceVisibility}">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Toolbar -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <!-- Search on Right -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBlock Text="بحث:" FontSize="13.5" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#334155"/>
                            <TextBox Width="260" Height="38" FontSize="13.5" VerticalContentAlignment="Center"
                                     Padding="10,0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <!-- Action Buttons on Left -->
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                            <Button Content="💾  إنشاء فاتورة" Command="{Binding CreateInvoiceCommand}" Width="140" Style="{StaticResource BtnSuccess}" Margin="0,0,10,0" Visibility="{Binding CreateInvoiceVisibility}"/>
                            <Button Content="↩️  إعادة للتنفيذ" Command="{Binding RevertSelectedCommand}" Width="130" Style="{StaticResource BtnDanger}" Margin="0,0,10,0" Visibility="{Binding CreateInvoiceVisibility}"/>
                            <Button Content="🖨️  معاينة الفاتورة" Command="{Binding PrintInvoiceCommand}" Width="135" Style="{StaticResource BtnGhost}"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- DataGrid with RTL Column Order (Order Number on the right) -->
                    <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E3EAF1" BorderThickness="1" CornerRadius="12" Padding="1">
                        <DataGrid ItemsSource="{Binding Orders}" SelectedItem="{Binding SelectedOrder}"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0"
                                  RowHeight="42" FontSize="13.5" SelectionMode="Single"
                                  BorderThickness="0" Background="Transparent">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="رقم أمر الإصلاح" Binding="{Binding RoNumber}" Width="140"/>
                                <DataGridTextColumn Header="اسم الزبون" Binding="{Binding CustomerName}" Width="*"/>
                                <DataGridTextColumn Header="هاتف الزبون" Binding="{Binding PhoneNumber}" Width="130"/>
                                <DataGridTextColumn Header="اسم السيارة" Binding="{Binding CarName}" Width="140"/>
                                <DataGridTextColumn Header="الموديل" Binding="{Binding CarModel}" Width="100"/>
                                <DataGridTextColumn Header="رقم الهيكل (VIN)" Binding="{Binding VIN}" Width="160"/>
                                <DataGridTextColumn Header="تاريخ الإكمال" Binding="{Binding CompletionDate}" Width="140"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- Tab 2: أرشيف الفواتير الصادرة -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <TabItem Header="📁 أرشيف الفواتير الصادرة" Padding="18,10">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Toolbar -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <!-- Search on Right -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="📅  فواتير اليوم" Command="{Binding FilterTodayInvoicesCommand}" Width="125" Height="38" Style="{StaticResource BtnGhost}" Margin="0,0,10,0"/>
                            <TextBlock Text="بحث في الأرشيف:" FontSize="13.5" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#334155"/>
                            <TextBox Width="260" Height="38" FontSize="13.5" VerticalContentAlignment="Center"
                                     Padding="10,0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <!-- Action Buttons on Left -->
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                            <Button Content="🖨️  طباعة الفاتورة" Command="{Binding PrintInvoiceCommand}" Width="150" Style="{StaticResource BtnPrimary}"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- DataGrid with RTL Column Order (Invoice Number on the right) -->
                    <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E3EAF1" BorderThickness="1" CornerRadius="12" Padding="1">
                        <DataGrid ItemsSource="{Binding Invoices}" SelectedItem="{Binding SelectedInvoice}"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0"
                                  RowHeight="42" FontSize="13.5" SelectionMode="Single"
                                  BorderThickness="0" Background="Transparent">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="رقم الفاتورة" Binding="{Binding InvoiceNumber}" Width="140"/>
                                <DataGridTextColumn Header="رقم أمر الإصلاح" Binding="{Binding RepairOrderNumber}" Width="130"/>
                                <DataGridTextColumn Header="تاريخ الفاتورة" Binding="{Binding InvoiceDate}" Width="140"/>
                                <DataGridTextColumn Header="اسم العميل" Binding="{Binding CustomerName}" Width="*"/>
                                <DataGridTextColumn Header="رقم الهاتف" Binding="{Binding CustomerPhone}" Width="120"/>
                                <DataGridTextColumn Header="رقم اللوحة" Binding="{Binding PlateNumber}" Width="110"/>
                                <DataGridTextColumn Header="السيارة" Binding="{Binding CarName}" Width="120"/>
                                <DataGridTextColumn Header="المبلغ المدفوع (د.ل)" Binding="{Binding PaidAmountDisplay}" Width="130"/>
                                <DataGridTextColumn Header="طريقة الدفع" Binding="{Binding PaymentMethod}" Width="130"/>
                                <DataGridTextColumn Header="منشئ الفاتورة" Binding="{Binding CreatedByUsername}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
