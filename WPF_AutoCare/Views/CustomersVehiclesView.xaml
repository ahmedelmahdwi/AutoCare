<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             FontFamily="Segoe UI, Tahoma, Arial"
             Background="{DynamicResource BackgroundBrush}">

    <UserControl.Resources>
        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#0284C7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#38BDF8"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="#0369A1"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnGhost" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#0284C7"/>
            <Setter Property="Background" Value="#F0F9FF"/>
            <Setter Property="BorderBrush" Value="#BAE6FD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#E0F2FE"/><Setter TargetName="bd" Property="BorderBrush" Value="#38BDF8"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="#BAE6FD"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
            <Setter Property="Background" Value="#EF4444"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#F87171"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="#DC2626"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnCyan" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
            <Setter Property="Background" Value="#06B6D4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#22D3EE"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="#0891B2"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title Row -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,0,2,12">
            <TextBlock Text="العملاء والسيارات" FontSize="24" FontWeight="Bold" FontFamily="{StaticResource HeaderFontFamily}" Foreground="#0F172A"/>
        </StackPanel>

        <!-- Toolbar (Exact duplicate of CustomersVehiclesScreen toolbar) -->
        <DockPanel Grid.Row="1" Margin="0,0,0,2">
            <!-- Search on Right -->
            <TextBox DockPanel.Dock="Right" Width="280" Height="38" FontSize="13.5" VerticalContentAlignment="Center"
                     Padding="10,0" Margin="0,0,0,0"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

            <!-- Filter Combo on Right -->
            <ComboBox DockPanel.Dock="Right" Width="150" Height="38" FontSize="13.5" Margin="10,0,10,0"
                      SelectedValuePath="Content" SelectedValue="{Binding StatusFilter}">
                <ComboBoxItem Content="الكل" IsSelected="True"/>
                <ComboBoxItem Content="معلق"/>
                <ComboBoxItem Content="قيد التنفيذ"/>
                <ComboBoxItem Content="مكتمل"/>
                <ComboBoxItem Content="ملغى"/>
            </ComboBox>

            <!-- Action Buttons on Left -->
            <Button DockPanel.Dock="Left" Content="+ فتح كرت صيانة" Command="{Binding OpenNewOrderCommand}" Width="160" Style="{StaticResource BtnPrimary}" Margin="0,0,0,0"/>
            <Button DockPanel.Dock="Left" Content="تعديل الكرت" Command="{Binding EditSelectedOrderCommand}" Width="120" Style="{StaticResource BtnGhost}" Margin="10,0,0,0"/>
            <Button DockPanel.Dock="Left" Content="إلغاء الأمر" Command="{Binding DeleteSelectedCommand}" Width="105" Style="{StaticResource BtnDanger}" Margin="10,0,0,0"/>
            <Button DockPanel.Dock="Left" Content="تاريخ المركبة" Command="{Binding ViewVehicleHistoryCommand}" Width="120" Style="{StaticResource BtnCyan}" Margin="10,0,0,0"/>
        </DockPanel>

        <!-- DataGrid in White Rounded Border (Exact duplicate of CustomersVehiclesScreen grid) -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E3EAF1" BorderThickness="1" CornerRadius="12" Margin="0,12,0,0" Padding="1">
            <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0"
                      RowHeight="42" FontSize="13.5" SelectionMode="Single"
                      BorderThickness="0" Background="Transparent">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="هاتف الزبون" Binding="{Binding PhoneNumber}" Width="130"/>
                    <DataGridTextColumn Header="اسم الزبون" Binding="{Binding FullName}" Width="170"/>
                    <DataGridTextColumn Header="رقم اللوحة" Binding="{Binding PlateNumber}" Width="120"/>
                    <DataGridTextColumn Header="اسم السيارة" Binding="{Binding CarName}" Width="140"/>
                    <DataGridTextColumn Header="الموديل" Binding="{Binding CarModel}" Width="90"/>
                    <DataGridTextColumn Header="تاريخ الإدخال" Binding="{Binding EntryDate}" Width="140"/>
                    <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="110"/>
                    <DataGridTextColumn Header="الشكوى" Binding="{Binding Complaint}" Width="220"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
