<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =========================================================================
         Light Crystal Liquid Glass Palette (Base: #0284C7 | RGB: 2, 132, 199)
         ========================================================================= -->

    <!-- Base Liquid Azure Color -->
    <Color x:Key="PrimaryColor">#0284C7</Color>

    <!-- Light Liquid Variations (Crystal Tints) -->
    <Color x:Key="PrimaryLightColor">#38BDF8</Color>
    <Color x:Key="PrimaryLight1Color">#38BDF8</Color>
    <Color x:Key="PrimaryLight2Color">#7DD3FC</Color>
    <Color x:Key="PrimaryLight3Color">#BAE6FD</Color>
    <Color x:Key="PrimaryTintLightColor">#E0F2FE</Color>
    <Color x:Key="PrimaryTintUltraLightColor">#F0F9FF</Color>

    <!-- Dark Liquid Variations (Oceanic Depth) -->
    <Color x:Key="PrimaryDarkColor">#0369A1</Color>
    <Color x:Key="PrimaryDark1Color">#0369A1</Color>
    <Color x:Key="PrimaryDark2Color">#075985</Color>
    <Color x:Key="PrimaryDark3Color">#0C4A6E</Color>

    <!-- Accent Colors (Luminous Liquid Gems) -->
    <Color x:Key="AccentColor">#F59E0B</Color>
    <Color x:Key="AccentAmberColor">#F59E0B</Color>
    <Color x:Key="AccentAmberDarkColor">#D97706</Color>
    <Color x:Key="AccentGreenColor">#10B981</Color>
    <Color x:Key="AccentGreenDarkColor">#059669</Color>
    <Color x:Key="AccentRedColor">#F43F5E</Color>
    <Color x:Key="AccentRedDarkColor">#E11D48</Color>
    <Color x:Key="AccentPurpleColor">#6366F1</Color>
    <Color x:Key="AccentPurpleDarkColor">#4F46E5</Color>

    <!-- Neutrals & Soothing Canvas Surfaces -->
    <Color x:Key="BackgroundColor">#EAF0F6</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="TextColor">#0F172A</Color>
    <Color x:Key="TextMutedColor">#475569</Color>
    <Color x:Key="BorderColor">#C8D7E6</Color>
    <Color x:Key="GridLineColor">#DEE8F2</Color>
    <Color x:Key="RowOddColor">#F4F8FC</Color>

    <!-- Card Background Colors (Translucent Liquid Infusions) -->
    <Color x:Key="CardBgAmberColor">#FFFBEB</Color>
    <Color x:Key="CardBgPrimaryColor">#F0F9FF</Color>
    <Color x:Key="CardBgGreenColor">#ECFDF5</Color>
    <Color x:Key="CardBgPurpleColor">#EEF2FF</Color>
    <Color x:Key="CardBgCyanColor">#ECFEFF</Color>

    <!-- =========================================================================
         SolidColorBrushes
         ========================================================================= -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryColorBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLightColor}"/>
    <SolidColorBrush x:Key="PrimaryLightColorBrush" Color="{StaticResource PrimaryLightColor}"/>
    <SolidColorBrush x:Key="PrimaryLight2Brush" Color="{StaticResource PrimaryLight2Color}"/>
    <SolidColorBrush x:Key="PrimaryLight3Brush" Color="{StaticResource PrimaryLight3Color}"/>
    <SolidColorBrush x:Key="PrimaryTintLightBrush" Color="{StaticResource PrimaryTintLightColor}"/>
    <SolidColorBrush x:Key="PrimaryTintUltraLightBrush" Color="{StaticResource PrimaryTintUltraLightColor}"/>

    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDarkColor}"/>
    <SolidColorBrush x:Key="PrimaryDarkColorBrush" Color="{StaticResource PrimaryDarkColor}"/>
    <SolidColorBrush x:Key="PrimaryDark2Brush" Color="{StaticResource PrimaryDark2Color}"/>
    <SolidColorBrush x:Key="PrimaryDark3Brush" Color="{StaticResource PrimaryDark3Color}"/>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentColorBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentAmberBrush" Color="{StaticResource AccentAmberColor}"/>
    <SolidColorBrush x:Key="AccentAmberDarkBrush" Color="{StaticResource AccentAmberDarkColor}"/>
    <SolidColorBrush x:Key="AccentGreenBrush" Color="{StaticResource AccentGreenColor}"/>
    <SolidColorBrush x:Key="AccentGreenDarkBrush" Color="{StaticResource AccentGreenDarkColor}"/>
    <SolidColorBrush x:Key="AccentRedBrush" Color="{StaticResource AccentRedColor}"/>
    <SolidColorBrush x:Key="AccentRedDarkBrush" Color="{StaticResource AccentRedDarkColor}"/>
    <SolidColorBrush x:Key="AccentPurpleBrush" Color="{StaticResource AccentPurpleColor}"/>
    <SolidColorBrush x:Key="AccentPurpleDarkBrush" Color="{StaticResource AccentPurpleDarkColor}"/>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="BackgroundColorBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceColorBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="TextColorBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="GridLineBrush" Color="{StaticResource GridLineColor}"/>
    <SolidColorBrush x:Key="DataGridRowEvenBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DataGridRowOddBrush" Color="{StaticResource RowOddColor}"/>
    <SolidColorBrush x:Key="DataGridRowSelectedBrush" Color="{StaticResource PrimaryLight3Color}"/>

    <!-- Card Brushes -->
    <SolidColorBrush x:Key="CardBgAmberBrush" Color="{StaticResource CardBgAmberColor}"/>
    <SolidColorBrush x:Key="CardBgPrimaryBrush" Color="{StaticResource CardBgPrimaryColor}"/>
    <SolidColorBrush x:Key="CardBgGreenBrush" Color="{StaticResource CardBgGreenColor}"/>
    <SolidColorBrush x:Key="CardBgPurpleBrush" Color="{StaticResource CardBgPurpleColor}"/>
    <SolidColorBrush x:Key="CardBgCyanBrush" Color="{StaticResource CardBgCyanColor}"/>

    <!-- =========================================================================
         Liquid Glass LinearGradientBrushes
         ========================================================================= -->
    <!-- Primary Fluid Glass Gradient -->
    <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#38BDF8" Offset="0.0"/>
        <GradientStop Color="#0284C7" Offset="0.5"/>
        <GradientStop Color="#0369A1" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- NavBar Gradient: Deep oceanic crystal glass -->
    <LinearGradientBrush x:Key="NavBarGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0F283C" Offset="0.0"/>
        <GradientStop Color="#0B2032" Offset="0.5"/>
        <GradientStop Color="#071724" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- DataGrid Header: Crisp liquid azure gradient -->
    <LinearGradientBrush x:Key="DataGridHeaderBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#0284C7" Offset="0.0"/>
        <GradientStop Color="#0369A1" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Button Action Gradients -->
    <LinearGradientBrush x:Key="ButtonPrimaryGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#38BDF8" Offset="0.0"/>
        <GradientStop Color="#0284C7" Offset="0.55"/>
        <GradientStop Color="#0369A1" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ButtonGreenGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#34D399" Offset="0.0"/>
        <GradientStop Color="#10B981" Offset="0.5"/>
        <GradientStop Color="#059669" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ButtonRedGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FB7185" Offset="0.0"/>
        <GradientStop Color="#F43F5E" Offset="0.5"/>
        <GradientStop Color="#E11D48" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ButtonAmberGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FBBF24" Offset="0.0"/>
        <GradientStop Color="#F59E0B" Offset="0.5"/>
        <GradientStop Color="#D97706" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- =========================================================================
         Liquid Glass Design System Tokens
         ========================================================================= -->
    <!-- Frosted Crystal Surfaces -->
    <SolidColorBrush x:Key="GlassSurfaceBrush" Color="#E6FFFFFF"/>
    <SolidColorBrush x:Key="GlassCardBrush" Color="#F4FFFFFF"/>
    <SolidColorBrush x:Key="GlassBorderBrush" Color="#80BAE6FD"/>
    <SolidColorBrush x:Key="GlassBorderSubtleBrush" Color="#40BAE6FD"/>
    <SolidColorBrush x:Key="GlassInputBgBrush" Color="#F8FCFE"/>
    <SolidColorBrush x:Key="GlassDarkCardBrush" Color="#CC0A2234"/>
    <SolidColorBrush x:Key="GlassDarkBorderBrush" Color="#4038BDF8"/>

    <!-- Ambient Mesh & Header Gradients -->
    <LinearGradientBrush x:Key="GlassMeshGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F0F9FF" Offset="0.0"/>
        <GradientStop Color="#E0F2FE" Offset="0.4"/>
        <GradientStop Color="#BAE6FD" Offset="0.8"/>
        <GradientStop Color="#E0F2FE" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassNavBarBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F00F283C" Offset="0.0"/>
        <GradientStop Color="#F40B2032" Offset="0.6"/>
        <GradientStop Color="#F8071724" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassHeaderGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#F8FFFFFF" Offset="0.0"/>
        <GradientStop Color="#E8F4F9" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- =========================================================================
         Global Typography: Header Font (HasanAya) vs Body/Data Font (Segoe UI)
         ========================================================================= -->
    <FontFamily x:Key="HeaderFontFamily">HasanAyaW23-Regular, Tahoma, Segoe UI</FontFamily>
    <FontFamily x:Key="BodyFontFamily">Segoe UI, Tahoma, Arial</FontFamily>

    <!-- =========================================================================
         Standard Clean Architecture DataGrid Styles (Matching UI.StyleGrid 100%)
         ========================================================================= -->
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource DataGridHeaderBrush}"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="FontFamily" Value="{StaticResource HeaderFontFamily}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Height" Value="42"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="BorderThickness" Value="0,0,1,0"/>
        <Setter Property="BorderBrush" Value="#0369A1"/>
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="FontFamily" Value="Segoe UI, Tahoma, Arial"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource DataGridRowSelectedBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#E0F2FE"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="FontFamily" Value="Segoe UI, Tahoma, Arial"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="RowBackground" Value="{StaticResource DataGridRowEvenBrush}"/>
        <Setter Property="AlternatingRowBackground" Value="{StaticResource DataGridRowOddBrush}"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource GridLineBrush}"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="ColumnHeaderHeight" Value="42"/>
        <Setter Property="RowHeight" Value="40"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="FontFamily" Value="Segoe UI, Tahoma, Arial"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
        <Setter Property="FlowDirection" Value="RightToLeft"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <!-- =========================================================================
         Standard Premium Dialog Button Styles (Save, Close, Cancel, Action)
         ========================================================================= -->
    <!-- Dialog Save / Confirm Button (Emerald Green Gradient + Shadow + Tactile Feedback) -->
    <Style x:Key="BtnDialogSave" TargetType="Button">
        <Setter Property="Height" Value="42"/>
        <Setter Property="MinWidth" Value="135"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="Background" Value="{StaticResource ButtonGreenGradientBrush}"/>
        <Setter Property="BorderBrush" Value="#059669"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="20,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Opacity="0.16" Color="#059669"/>
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#34D399" Offset="0.0"/>
                                        <GradientStop Color="#10B981" Offset="0.5"/>
                                        <GradientStop Color="#047857" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="bd" Property="BorderBrush" Value="#10B981"/>
                            <Setter TargetName="bd" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270" Opacity="0.28" Color="#10B981"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#059669" Offset="0.0"/>
                                        <GradientStop Color="#047857" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="bd" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform Y="1"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="#CBD5E1"/>
                            <Setter Property="Foreground" Value="#94A3B8"/>
                            <Setter TargetName="bd" Property="Effect" Value="{x:Null}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

